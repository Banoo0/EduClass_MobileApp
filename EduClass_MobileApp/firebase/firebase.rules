rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Fungsi bantu ----------
    function signedIn() {
      return request.auth != null;
    }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isTeacher() {
      return signedIn() && myRole() == 'guru';
    }
    function isStudent() {
      return signedIn() && myRole() == 'siswa';
    }
    // Siswa dianggap anggota kelas jika dokumen class_members/{classId}_{uid} ada.
    function isMember(classId) {
      return signedIn()
        && exists(/databases/$(database)/documents/class_members/$(classId + '_' + request.auth.uid));
    }

    // Daftar sekolah boleh dibaca siapa saja (form register), tidak bisa diubah dari aplikasi.
    match /schools/{schoolId} {
      allow read: if true;
      allow write: if false;
    }

    // Profil: hanya pemiliknya. Role ditentukan saat daftar dan tidak bisa diubah.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.role in ['guru', 'siswa']
        && request.resource.data.nama_lengkap is string
        && request.resource.data.nama_lengkap.size() >= 3
        && request.resource.data.keys().hasOnly(
             ['nama_lengkap', 'role', 'nomor_induk', 'rombel', 'school_id', 'school_nama', 'created_at']);

      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;

      allow delete: if false;
    }

    // ---------- Kelas ----------
    match /classes/{classId} {
      allow read: if signedIn()
        && (resource == null || resource.data.teacher_id == request.auth.uid || isMember(classId));

      allow create: if isTeacher()
        && request.resource.data.teacher_id == request.auth.uid
        && request.resource.data.nama_mapel is string
        && request.resource.data.nama_mapel.size() > 0
        && request.resource.data.keys().hasOnly(
             ['teacher_id', 'teacher_nama', 'nama_mapel', 'rombel', 'tahun_ajaran',
              'semester', 'token', 'aktif', 'created_at']);

      // Guru pemilik boleh mengubah kelasnya, tetapi tidak pemilik dan token-nya.
      allow update: if signedIn()
        && resource.data.teacher_id == request.auth.uid
        && request.resource.data.teacher_id == resource.data.teacher_id
        && request.resource.data.token == resource.data.token;

      allow delete: if signedIn() && resource.data.teacher_id == request.auth.uid;
    }

    // Token gabung kelas: boleh dibaca satu per satu (get), tidak boleh didaftar (list).
    match /class_tokens/{token} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if isTeacher()
        && request.resource.data.teacher_id == request.auth.uid
        && request.resource.data.keys().hasOnly(['class_id', 'teacher_id', 'aktif']);

      allow update: if signedIn()
        && resource.data.teacher_id == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aktif']);

      allow delete: if signedIn() && resource.data.teacher_id == request.auth.uid;
    }

    // Anggota kelas. ID dokumen = {classId}_{studentId} sehingga siswa tidak bisa bergabung dua kali.
    match /class_members/{memberId} {
      allow get: if signedIn()
        && (resource == null
            || resource.data.student_id == request.auth.uid
            || resource.data.teacher_id == request.auth.uid);
      allow list: if signedIn()
        && (resource.data.student_id == request.auth.uid
            || resource.data.teacher_id == request.auth.uid);

      // Siswa hanya bisa mendaftarkan dirinya sendiri, dengan token yang valid dan aktif.
      allow create: if isStudent()
        && memberId == request.resource.data.class_id + '_' + request.auth.uid
        && request.resource.data.student_id == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['class_id', 'student_id', 'teacher_id', 'student_nama', 'nomor_induk', 'token', 'joined_at'])
        && validJoinToken(request.resource.data);

      allow update: if false;

      // Siswa boleh keluar kelas; guru pemilik boleh mengeluarkan siswa.
      allow delete: if signedIn()
        && (resource.data.student_id == request.auth.uid
            || resource.data.teacher_id == request.auth.uid);
    }

    function validJoinToken(d) {
      let t = get(/databases/$(database)/documents/class_tokens/$(d.token)).data;
      return t.class_id == d.class_id && t.teacher_id == d.teacher_id && t.aktif == true;
    }

    // ---------- Jadwal ----------
    match /schedules/{scheduleId} {
      allow read: if signedIn()
        && (resource.data.teacher_id == request.auth.uid || isMember(resource.data.class_id));

      // getAfter dipakai karena kelas dan jadwal pertama dibuat dalam satu batch.
      allow create: if isTeacher()
        && request.resource.data.teacher_id == request.auth.uid
        && getAfter(/databases/$(database)/documents/classes/$(request.resource.data.class_id)).data.teacher_id
             == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['class_id', 'teacher_id', 'judul', 'hari', 'jam_mulai', 'jam_selesai',
              'ruang', 'gedung', 'meeting_url', 'created_at']);

      allow update: if signedIn()
        && resource.data.teacher_id == request.auth.uid
        && request.resource.data.teacher_id == request.auth.uid
        && request.resource.data.class_id == resource.data.class_id;

      allow delete: if signedIn() && resource.data.teacher_id == request.auth.uid;
    }

    // ---------- Pertemuan ----------
    match /meetings/{meetingId} {
      allow get: if signedIn()
        && (resource == null
            || resource.data.teacher_id == request.auth.uid
            || isMember(resource.data.class_id));
      allow list: if signedIn()
        && (resource.data.teacher_id == request.auth.uid || isMember(resource.data.class_id));

      allow create: if isTeacher()
        && request.resource.data.teacher_id == request.auth.uid
        && meetingId.matches(request.resource.data.schedule_id + '_.*')
        && get(/databases/$(database)/documents/schedules/$(request.resource.data.schedule_id)).data.teacher_id
             == request.auth.uid
        && get(/databases/$(database)/documents/schedules/$(request.resource.data.schedule_id)).data.class_id
             == request.resource.data.class_id
        && request.resource.data.keys().hasOnly(
             ['schedule_id', 'class_id', 'teacher_id', 'tanggal', 'topik', 'deskripsi',
              'presensi_dibuka_at', 'presensi_ditutup_at', 'created_at']);

      allow update: if signedIn()
        && resource.data.teacher_id == request.auth.uid
        && request.resource.data.teacher_id == resource.data.teacher_id
        && request.resource.data.class_id == resource.data.class_id
        && request.resource.data.schedule_id == resource.data.schedule_id;

      allow delete: if signedIn() && resource.data.teacher_id == request.auth.uid;
    }

    // ---------- Presensi ----------
    match /attendance/{attendanceId} {
      allow get: if signedIn()
        && (resource == null
            || resource.data.student_id == request.auth.uid
            || resource.data.teacher_id == request.auth.uid);
      allow list: if signedIn()
        && (resource.data.student_id == request.auth.uid
            || resource.data.teacher_id == request.auth.uid);

      // Guru mencatat presensi siapa saja di kelasnya; siswa hanya untuk dirinya sendiri
      // dan hanya selama presensi pertemuan itu sedang dibuka.
      allow create: if signedIn()
        && attendanceId == request.resource.data.meeting_id + '_' + request.resource.data.student_id
        && request.resource.data.status is string
        && request.resource.data.keys().hasOnly(
             ['meeting_id', 'class_id', 'teacher_id', 'student_id', 'status', 'waktu_absen'])
        && meetingMatches(request.resource.data)
        && ((isTeacher() && request.resource.data.teacher_id == request.auth.uid)
            || (request.resource.data.student_id == request.auth.uid
                && isMember(request.resource.data.class_id)
                && meetingOpen(request.resource.data.meeting_id)));

      allow update: if signedIn()
        && resource.data.teacher_id == request.auth.uid
        && request.resource.data.teacher_id == request.auth.uid
        && request.resource.data.meeting_id == resource.data.meeting_id
        && request.resource.data.student_id == resource.data.student_id
        && request.resource.data.class_id == resource.data.class_id;

      allow delete: if signedIn() && resource.data.teacher_id == request.auth.uid;
    }

    function meetingMatches(d) {
      let m = get(/databases/$(database)/documents/meetings/$(d.meeting_id)).data;
      return m.class_id == d.class_id && m.teacher_id == d.teacher_id;
    }
    function meetingOpen(meetingId) {
      let m = get(/databases/$(database)/documents/meetings/$(meetingId)).data;
      return m.presensi_dibuka_at != null && m.presensi_ditutup_at == null;
    }
  }
}